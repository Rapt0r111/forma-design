# Canonical URL for sitemap, robots and Open Graph.
# On Vercel this can stay empty: the production domain is picked up automatically.
NEXT_PUBLIC_SITE_URL=

# Optional: Upstash Redis / Vercel KV so demo leads survive across serverless instances.
# Without these, the loop still works via in-memory + the visitor's browser.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional extra Origin allowed to POST/PATCH /api/leads (same-host is always allowed).
ALLOWED_ORIGIN=
